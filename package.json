{
  "name": "kmp-publisher",
  "version": "0.3.12",
  "description": "Interface multiplataforma para propor ports ao catálogo KMP",
  "main": "src/main.js",
  "author": "FerreiraTechLab",
  "license": "GPL-3.0-or-later",
  "scripts": {
    "start": "node scripts/start-electron.js",
    "test": "node --test",
    "package": "electron-builder --publish never"
  },
  "dependencies": {
    "bencode": "^3.0.3",
    "yauzl": "^3.2.0"
  },
  "devDependencies": {
    "electron": "^38.2.2",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "dev.ferreiratechlab.kmppublisher",
    "productName": "KMP Publisher",
    "files": [
      "src/**/*",
      "package.json",
      "README.md",
      "docs/**/*",
      "schemas/**/*"
    ],
    "extraResources": [
      {
        "from": "resources/catalog-root.pub",
        "to": "catalog-root.pub"
      },
      {
        "from": "resources/torrentd/${platform}-${arch}",
        "to": "torrentd/${platform}-${arch}"
      }
    ],
    "directories": {
      "output": "release"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Development"
    },
    "win": {
      "target": [
        "nsis"
      ]
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "category": "public.app-category.developer-tools"
    }
  }
}
